name: BBE Demo
type: sw.application
version: 0.0.0
description: >-
  Demonstration app to show off various blocks implemented in 
  this project.
  WARNING: The range of blocks integrated in this demo is absolutely
  expected to change from version to version.  
assets:
  repository:
    type: blob.asset
    data:
      url: 'https://github.com/tim-littlefair/balena-block-experiments'
  logo:
    type: blob.asset
    data:
      url: >-
        https://heretical-camelid.net/_static/heretical-camelid-noattr.svg
data:
  applicationEnvironmentVariables:
    - LAUNCH_URL: https://heretical-camelid.net/
  defaultDeviceType: raspberrypi0-2w-64
  supportedDeviceTypes:
    - raspberrypi3-64
    - raspberrypi4-64
    - raspberrypi0-2w-64
