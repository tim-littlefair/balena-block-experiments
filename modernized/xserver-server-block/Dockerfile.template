# Generic preamble (replaces deprecated balenalib/Bullseye image)
FROM debian:trixie

# As we are no longer using the balenalib image we no longer have
# the Balena-specific install_packages command which hides 
# apt vs yum vs ... package management command differences
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -y update ; apt-get -y upgrade 

# Adding apt-utils before getting any other packages to avoid
# warnings about its absence
RUN apt-get -y install apt-utils

# The first group of packages to be installed exactly matches the
# list of packages explicitly installed in the Dockerfile.template
# of balenalib-based upstream xserver v0.2.0
ARG XSERVER_DOCKERFILE_PACKAGES="\
    matchbox-window-manager \
    x11-xserver-utils \
    x11-utils \
    xauth \
    xinit \
    xinput \
    xserver-xorg \
    xserver-xorg-input-all \
    xserver-xorg-input-evdev \
    xserver-xorg-legacy \
    xserver-xorg-video-all \
"

# The second group brings in all additional packages installed by 
# upstream xserver's build/install_chromium script, except for 
# those mentioned above and the chromium and chromium-common
# packages
ARG XSERVER_INSTALL_CHROMIUM_PACKAGES="\
    ca-certificates \
    curl \
    lsb-release \
    mesa-vdpau-drivers \
    mesa-vulkan-drivers \
    scrot \
    x11-xserver-utils \
    xserver-xorg-video-fbdev \
    xterm \
"

RUN apt-get -y --no-install-recommends install \
    $XSERVER_DOCKERFILE_PACKAGES $XSERVER_INSTALL_CHROMIUM_PACKAGES

WORKDIR /opt/xserver

COPY src/xinitrc /root/.xinitrc
RUN chmod a+x /root/.xinitrc

COPY src/entry.sh src/config.sh src/balenalib-xserver-entry.sh VERSION /opt/xserver/

ENTRYPOINT  ["/bin/bash", "/opt/xserver/entry.sh"]


ENV CURSOR=true \
    UDEV=on \
    FORCE_DISPLAY=:0
