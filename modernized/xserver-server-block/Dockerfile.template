# We need to switch from Balena's Docker images to generic ones

# Docker preamble:
ARG BALENA_ARCH=%%BALENA_ARCH%%
FROM balenalib/$BALENA_ARCH-debian:bullseye
# mentions of the install_packages script need to be replaced
# with apt-get equivalents

# Generic preamble:
#FROM debian:bullseye
RUN apt-get -y update ; apt-get -y upgrade ; apt-get -y install apt-utils

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -y --no-install-recommends install \
    matchbox-window-manager \
    x11-xserver-utils \
    x11-utils \
    xauth \
    xinit \
    xinput \
    xserver-xorg \
    xserver-xorg-input-all \
    xserver-xorg-input-evdev \
    xserver-xorg-legacy \
    xserver-xorg-video-all

WORKDIR /opt/xserver

COPY ./xinitrc /root/.xinitrc

COPY ./entry.sh ./config.sh VERSION /opt/xserver/

ENTRYPOINT  ["/bin/bash", "/opt/xserver/entry.sh"]

ENV CURSOR=true \
    UDEV=on \
    FORCE_DISPLAY=:0
