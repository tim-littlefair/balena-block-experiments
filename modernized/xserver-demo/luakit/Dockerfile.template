FROM balenalib/%%BALENA_MACHINE_NAME%%-debian:bullseye
#FROM debian:bullseye

RUN apt-get -y update ; apt-get -y upgrade ; apt-get -y install apt-utils

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -y --no-install-recommends install x11-apps
RUN apt-get -y --no-install-recommends install ca-certificates luakit 

COPY entry.sh /

ENTRYPOINT  ["bash", "entry.sh"]

ENV DISPLAY=:0
